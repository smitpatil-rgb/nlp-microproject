# Translation provider: local Argos Translate models, called through the local server route.
TRANSLATION_PROVIDER=local-argos
# LibreTranslate is optional when ARGOS_PYTHON is configured. It is a local HTTP fallback.
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
# The project uses these installed local files; no Google or paid API is used.
ARGOS_PYTHON=work/libretranslate-venv/Scripts/python.exe
ARGOS_SCRIPT=scripts/argos-translate-once.py
